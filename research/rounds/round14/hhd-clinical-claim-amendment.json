  "claim_map": [
    {
      "id": "C01",
      "claim": "Visible disease benefit",
      "new_fact": "Positive HS primary AN-count contrast; overlapping endpoints are one cohort, not independent corroboration.",
      "HHD_consequence": "Retain HHD-specific controlled proof; no imported response probability, ATP2C1 correction or HHD participant count."
    },
    {
      "id": "C02",
      "claim": "Painful disease and burden benefit",
      "new_fact": "Registry pain and itch contrasts do not demonstrate superiority; uncertainty includes benefit and disadvantage.",
      "HHD_consequence": "Match one prospectively selected primary to the intended claim; retain pain/rescue/burden support without demanding superiority on every secondary."
    },
    {
      "id": "C03",
      "claim": "Benefit across assigned patients",
      "new_fact": "34/35 randomized; lesion endpoint display 24/32; symptoms 23/22; 10/3 DBVC noncompleters.",
      "HHD_consequence": "Distinguish assignment, treatment, observation, model contribution and extension entry; prespecify rescue and missingness; no inferred imputation or sensitivity analysis."
    },
    {
      "id": "C04",
      "claim": "Benefit against relevant care",
      "new_fact": "HS sponsor vehicle comparison does not secure our vehicle route or compare all HHD care.",
      "HHD_consequence": "Retain qualified matched vehicle or the defined whole-product add-on comparison against the same care; distinguish incremental, active-component and replacement claims."
    },
    {
      "id": "C05",
      "claim": "Maintenance and recurrence control",
      "new_fact": "Selected extension entry and all-active exposure after week16 do not estimate contemporaneous vehicle-controlled maintenance.",
      "HHD_consequence": "Separate ongoing control from drug-free durability and all-randomized from extension populations; early-versus-delayed randomized strategy inference would need its own estimand."
    },
    {
      "id": "C06",
      "claim": "Safety at relevant exposure",
      "new_fact": "Grade>=3 events differ by phase; pooled active safety includes crossover recipients.",
      "HHD_consequence": "No independent-arm comparison of pooled exposure groups, causal attribution or HHD exposure-margin clearance."
    },
    {
      "id": "C07",
      "claim": "HHD advancement or stopping",
      "new_fact": "Other-disease lesion activity and uncertain symptoms cannot decide HHD usefulness.",
      "HHD_consequence": "Retain rank3 and10 points; no new primary choice, threshold, duration, sample size, S-tier or asset promotion."
    }
  ],
