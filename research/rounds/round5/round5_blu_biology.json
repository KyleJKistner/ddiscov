  "proposed_gates": [
    {
      "id": "A",
      "name": "qualified_model",
      "advance": "Reproducible pre-treatment deficit and interpretable trajectory; genetic disease dependence; separate demonstration of post-deficit modifiability.",
      "stop": "Model not genetically rescuable or dynamic range inadequate; classify assay failure.",
      "status": "not_run"
    },
    {
      "id": "B",
      "name": "post_deficit_function",
      "advance": "At least two relevant patient backgrounds; sustained force plus fatigue/relaxation; lower confidence bound exceeds both repeatability floor and predeclared minimum useful effect; donor/batch-aware inference.",
      "stop": "Only differentiation or markers improve, or confidence interval lies below the minimum useful effect. Crossing the threshold is inconclusive.",
      "status": "not_run"
    },
    {
      "id": "C",
      "name": "target_attribution",
      "advance": "Engagement and compartmental PD align with orthogonal functional perturbation.",
      "stop": "Effect requires off-target exposure or is uncoupled from target.",
      "status": "not_run"
    },
    {
      "id": "D",
      "name": "exposure_window",
      "advance": "Measure intrinsic tissue sensitivity and unbound muscle/plasma and vulnerable-tissue/plasma relationships; preserve function across exposure uncertainty.",
      "stop": "Measured required exposure in a vulnerable tissue overlaps adverse function without usable separation. In-vitro overlap with unknown tissue distribution is a hold, not an automatic systemic stop.",
      "status": "not_run",
      "caution": "No BBB exclusion or favorable muscle targeting is assumed for BLU3797."
    },
    {
      "id": "E",
      "name": "sustained_response",
      "advance": "Sustained gain and interpretable washout/rechallenge without progressive adverse function.",
      "stop": "Early gains reverse during maintained exposure or toxicity accumulates.",
      "status": "not_run"
    },
    {
      "id": "F",
      "name": "differentiation",
      "advance": "Useful advantage versus same-model comparator in function, durability, tolerability or delivery.",
      "stop": "No practical advantage despite target biology.",
      "status": "not_run"
    }
