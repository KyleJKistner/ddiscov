  "claim_decisions": [
    {
      "id": "C01",
      "claim": "RM4404 merits a bounded independent useful-function question",
      "decision": "retain_conditional",
      "support": [
        "R08",
        "R09",
        "R11",
        "R13",
        "R15",
        "R16",
        "R21"
      ],
      "reason": "Concordant source-reported sensory/structural findings survive correct endpoint-specific reading; no independent replication or human benefit established."
    },
    {
      "id": "C02",
      "claim": "No public direct drug–vehicle contrast exists for the long CMI sensory regimen",
      "decision": "amend_scope",
      "support": [
        "R06",
        "R07",
        "R21"
      ],
      "reason": "The 2025abstract reports one; the final-paper caption still uses healthy-reference contrasts. Preliminary and final methods/units are not interchangeable."
    },
    {
      "id": "C03",
      "claim": "Three-digit histologyN is an animal denominator or proves barrier repair",
      "decision": "reject",
      "support": [
        "R17",
        "R18",
        "R19"
      ],
      "reason": "Three mice/group with nested sections/readings; retain author observation but no invented animal-level significance or functional barrier proof."
    },
    {
      "id": "C04",
      "claim": "Normal-range blink threshold excludes hyperalgesia or establishes useful sensory quality",
      "decision": "not_established",
      "support": [
        "R01",
        "R20"
      ],
      "reason": "Ceiling-limited mechanically evoked blink cannot separately identify pain, visual performance, epithelium protection or supra-normal sensitivity."
    },
    {
      "id": "C05",
      "claim": "Delayed dosing is intrinsically superior because it targets a unique regenerative phase",
      "decision": "not_isolated_by_comparison",
      "support": [
        "R14"
      ],
      "reason": "Phase and time since last dose differ; a plausible phase hypothesis is not a clean causal timing result."
    },
    {
      "id": "C06",
      "claim": "All structure evidence is undermined by weak late CMI contrasts",
      "decision": "reject_overgeneralization",
      "support": [
        "R04",
        "R05",
        "R08",
        "R09",
        "R11"
      ],
      "reason": "Unilateral NM supplies direct drug–vehicle structural comparisons; keep injury and timing specific."
    },
    {
      "id": "C07",
      "claim": "Early-NM day14 signal proves delayed-CMI durable repair or clearance",
      "decision": "reject_transfer",
      "support": [
        "R05",
        "R07",
        "R13",
        "R15",
        "R16"
      ],
      "reason": "Regimens/cohorts and calendar off-dosing intervals remain distinct; no PK washout established."
    },
    {
      "id": "C08",
      "claim": "Permanent off-treatment regeneration is the only valuable product outcome",
      "decision": "not_required_universally",
      "support": [
        "R01",
        "R13",
        "R20"
      ],
      "reason": "Useful ongoing control or a useful finite-course benefit can have value; durable drug-free repair needs the additional evidence appropriate to that stronger claim.",
      "basis_kind": "stage_and_claim_judgment"
    }
  ],
